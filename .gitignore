# ===========================================
# NUXNAN Project - Production .gitignore
# Only push: api/nuxnanravel/ and ui/
# ===========================================

# ===========================================
# IGNORE EVERYTHING BY DEFAULT
# ===========================================
/*
/.*

# ===========================================
# WHITELIST - Only these folders are tracked
# ===========================================
!.gitignore
!/api/
!/ui/

# ===========================================
# API folder - only nuxnanravel is needed
# ===========================================
/api/*
!/api/nuxnanravel/

# API Laravel - ignore build/runtime files
/api/nuxnanravel/vendor/
/api/nuxnanravel/node_modules/
/api/nuxnanravel/.env
/api/nuxnanravel/.env.*
/api/nuxnanravel/production.env
!/api/nuxnanravel/.env.example
/api/nuxnanravel/storage/logs/*
!/api/nuxnanravel/storage/logs/.gitkeep
/api/nuxnanravel/storage/framework/cache/*
!/api/nuxnanravel/storage/framework/cache/.gitkeep
/api/nuxnanravel/storage/framework/sessions/*
!/api/nuxnanravel/storage/framework/sessions/.gitkeep
/api/nuxnanravel/storage/framework/views/*
!/api/nuxnanravel/storage/framework/views/.gitkeep
/api/nuxnanravel/storage/app/public/*
!/api/nuxnanravel/storage/app/public/.gitkeep
/api/nuxnanravel/bootstrap/cache/*.php
/api/nuxnanravel/public/hot
/api/nuxnanravel/public/storage
/api/nuxnanravel/public/build
/api/nuxnanravel/.phpunit.result.cache
/api/nuxnanravel/Homestead.json
/api/nuxnanravel/Homestead.yaml
/api/nuxnanravel/*.log

# ===========================================
# UI folder - ignore build/runtime files
# ===========================================
/ui/node_modules/
/ui/.nuxt/
/ui/.output/
/ui/.nitro/
/ui/.cache/
/ui/.data/
/ui/dist/
/ui/.env
/ui/.env.*
!/ui/.env.example
/ui/*.log

# ===========================================
# OS & IDE files (global)
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
.vs/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
